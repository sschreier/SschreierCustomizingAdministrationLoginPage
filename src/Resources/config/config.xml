<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>general settings</title>
        <title lang="de-DE">Allgemeine Einstellungen</title>

        <input-field type="colorpicker">
            <name>loginBackgroundColor</name>
            <label>background color of the page</label>
            <label lang="de-DE">Hintergrundfarbe der Seite</label>
            <css>sschreier-customizing-administration-login-page-login-background-color</css>
            <defaultValue>#fafbfe</defaultValue>
            <placeholder>#fafbfe</placeholder>
        </input-field>

        <input-field type="bool">
            <name>showShopwareLogo</name>
            <label>show shopware logo</label>
            <label lang="de-DE">Shopware-Logo anzeigen</label>
            <defaultValue>true</defaultValue>
        </input-field>
    </card>

    <card>
        <title>general settings for the headline</title>
        <title lang="de-DE">Allgemeine Einstellungen für die Überschrift</title>

        <input-field type="bool">
            <name>showContentHeadline</name>
            <label>show</label>
            <label lang="de-DE">anzeigen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="text">
            <name>contentHeadline</name>
            <label>text</label>
            <label lang="de-DE">Text</label>
            <placeholder>Melde Dich bei Shopware an</placeholder>
        </input-field>

        <input-field type="colorpicker">
            <name>contentHeadlineFontColor</name>
            <label>font color</label>
            <label lang="de-DE">Schriftfarbe</label>
            <css>sschreier-customizing-administration-login-page-content-headline-font-color</css>
            <defaultValue>#1e1e24</defaultValue>
            <placeholder>#1e1e24</placeholder>
        </input-field>

        <input-field type="int">
            <name>contentHeadlineFontSize</name>
            <label>font size in pixels</label>
            <label lang="de-DE">Schriftgröße in Pixeln</label>
            <defaultValue>28</defaultValue>
            <placeholder>28</placeholder>
        </input-field>
    </card>
    
    <card>
        <title>general settings for the sub headline</title>
        <title lang="de-DE">Allgemeine Einstellungen für den Text unterhalb der Überschrift</title>

        <input-field type="bool">
            <name>showContentSubHeadline</name>
            <label>show</label>
            <label lang="de-DE">anzeigen</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="text">
            <name>contentSubHeadline</name>
            <label>text</label>
            <label lang="de-DE">Text</label>
        </input-field>

        <input-field type="colorpicker">
            <name>contentSubHeadlineFontColor</name>
            <label>font color</label>
            <label lang="de-DE">Schriftfarbe</label>
            <css>sschreier-customizing-administration-login-page-content-sub-headline-font-color</css>
            <defaultValue>#1e1e24</defaultValue>
            <placeholder>#1e1e24</placeholder>
        </input-field>

        <input-field type="int">
            <name>contentSubHeadlineFontSize</name>
            <label>font size in pixels</label>
            <label lang="de-DE">Schriftgröße in Pixeln</label>
            <defaultValue>14</defaultValue>
            <placeholder>14</placeholder>
        </input-field>

        <input-field type="int">
            <name>contentSubHeadlineMarginTop</name>
            <label>outer distance upwards in pixels</label>
            <label lang="de-DE">Außenabstand nach oben in Pixeln</label>
            <defaultValue>5</defaultValue>
            <placeholder>5</placeholder>
        </input-field>
    </card>
</config>
